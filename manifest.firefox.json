{
  "manifest_version": 2,
  "name": "cors-unblocker",
  "version": "0.1.0",
  "description": "A browser extension for selectively relaxing CORS response headers during local web development, with whitelist and global modes.",
  "browser_action": {
    "default_popup": "popup/index.html",
    "default_title": "cors-unblocker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background/firefox.js"]
  },
  "devtools_page": "devtools/devtools.html",
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "<all_urls>",
    "storage",
    "activeTab",
    "webRequest",
    "webRequestBlocking"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cors-dev-tool@example.local",
      "strict_min_version": "115.0"
    }
  }
}
