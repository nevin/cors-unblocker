{
  "manifest_version": 2,
  "name": "CORS Unblocker",
  "version": "1.0.0",
  "description": "Fix CORS errors while you develop: see which calls are blocked, then relax CORS headers only for the pages you trust.",
  "homepage_url": "https://github.com/nevin/cors-unblocker",
  "browser_action": {
    "default_popup": "popup/index.html",
    "default_title": "CORS Unblocker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "background/firefox.js"
    ]
  },
  "devtools_page": "devtools/devtools.html",
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": [
    "<all_urls>",
    "storage",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "64": "assets/icon-64.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cors-unblocker@nevin.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
