{
  "manifest_version": 3,
  "name": "CORS Unblocker",
  "version": "1.0.0",
  "description": "Fix CORS errors while you develop: see which calls are blocked, then relax CORS headers only for the pages you trust.",
  "homepage_url": "https://github.com/nevin/cors-unblocker",
  "minimum_chrome_version": "128",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "CORS Unblocker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/chrome.js",
    "type": "module"
  },
  "devtools_page": "devtools/devtools.html",
  "options_page": "options/index.html",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
